{
  "name": "iwakula-website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:seed": "tsx server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit drop && drizzle-kit generate --config=drizzle.config.ts && drizzle-kit migrate --config=drizzle.config.ts && npm run db:seed",
    "db:fresh": "drizzle-kit push --force && npm run db:seed"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-bubble-menu": "^3.29.0",
    "@tiptap/extension-code": "^3.29.0",
    "@tiptap/extension-collaboration": "^3.29.0",
    "@tiptap/extension-drag-handle": "^3.29.0",
    "@tiptap/extension-drag-handle-vue-3": "^3.29.0",
    "@tiptap/extension-floating-menu": "^3.29.0",
    "@tiptap/extension-horizontal-rule": "^3.29.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-mention": "^3.29.0",
    "@tiptap/extension-node-range": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/markdown": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/suggestion": "^3.29.0",
    "@tiptap/vue-3": "^3.29.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.0",
    "nuxt": "^4.5.0",
    "nuxt-easy-lightbox": "^1.1.0",
    "sharp": "0.32.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "sharp@0.32.6": true,
    "vue-demi@0.14.10": true,
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1"
  },
  "overrides": {
    "sharp": "0.32.6"
  }
}
